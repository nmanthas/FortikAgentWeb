# Fortik environment overrides. Copy to .env for local use. NEVER put real
# secrets in this file or in git: credentials are read from the secret
# provider (secrets.provider in the config), referenced by name.

# Fortik's own system-of-record database (overrides database_url in the config).
FORTIK_DATABASE_URL=postgres://fortik_app@127.0.0.1:55432/fortik?sslmode=disable

# Integration tests: a SUPERUSER DSN on a disposable cluster (tests create/drop temp DBs).
FORTIK_TEST_PG_URL=postgres://postgres@127.0.0.1:55432/postgres?sslmode=disable

# With secrets.provider=env, secrets are read from FORTIK_SECRET_<NAME>, e.g.:
# FORTIK_SECRET_API_TOKENS=[{"name":"pgproxy","sha256":"<sha256 of token>","roles":["interceptor"]}]
# FORTIK_SECRET_AGENT_TOKENS={"claude_code_01":"<sha256 of token>"}
# FORTIK_SECRET_DIARY_SIGNING_KEY=<base64 ed25519 seed, from: fortik keygen>
# FORTIK_SECRET_ACME_AGENT_PASSWORD=<upstream db password>
