-- Least-privilege grants for Fortik's application role ({{app}}): what
-- `fortik serve` connects as. It is NOT the schema owner, so it cannot
-- disable the Diary's append-only triggers; append-only tables get no
-- UPDATE/DELETE. Applied by `fortik migrate -grant-app ROLE` (Compose, Helm)
-- and by scripts/dev-up.sh. Not a migration (no .sql extension): update it
-- with every migration that adds a table.
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM {{app}};
GRANT USAGE ON SCHEMA public TO {{app}};
GRANT SELECT, INSERT, UPDATE ON agents, actions, held_actions, undo_handles TO {{app}};
GRANT SELECT, INSERT ON diary, diary_roots TO {{app}};          -- append-only: no UPDATE/DELETE
GRANT SELECT, UPDATE ON diary_head TO {{app}};
GRANT SELECT ON schema_migrations TO {{app}};
-- Phase 2
GRANT SELECT, INSERT ON access_profiles TO {{app}};              -- append-only versions
GRANT SELECT, INSERT, UPDATE, DELETE ON integrations TO {{app}};
GRANT SELECT, INSERT, UPDATE ON credential_issuances, delayed_sends TO {{app}};
GRANT SELECT, INSERT, UPDATE, DELETE ON console_sessions TO {{app}};
-- Phase 3
GRANT SELECT, INSERT, UPDATE ON delegations, instances, alerts, access_overrides, approval_grants TO {{app}};
GRANT SELECT, INSERT, UPDATE ON agent_types, spawn_stats TO {{app}};
GRANT SELECT, INSERT ON held_approvals TO {{app}};
GRANT UPDATE ON held_actions TO {{app}};
-- Phase 4
GRANT SELECT, INSERT, UPDATE ON memory_access, memory_snapshots, containment_ops TO {{app}};
-- Phase 5
GRANT SELECT, INSERT, UPDATE ON swarms, swarm_members, swarm_breakers, edge_rollup_state, shadow_findings TO {{app}};
GRANT SELECT, INSERT, UPDATE, DELETE ON swarm_release_votes, edges, baseline_hourly, edge_links TO {{app}};
-- Phase 6
GRANT SELECT, INSERT, DELETE ON map_events TO {{app}};
GRANT USAGE, SELECT ON SEQUENCE map_events_id_seq TO {{app}};
GRANT SELECT, INSERT, UPDATE ON connectors, connector_grants TO {{app}};
-- DELETE: codes older than the replay window are pruned per connector.
GRANT SELECT, INSERT, UPDATE, DELETE ON connector_codes TO {{app}};
GRANT SELECT, INSERT, DELETE ON connector_pending TO {{app}};
GRANT SELECT, INSERT ON connector_audit_seen TO {{app}};
-- SaaS connectors (Milestone 1): ingestion cursor and dedup.
GRANT SELECT, INSERT, UPDATE ON saas_sync_state TO {{app}};
GRANT SELECT, INSERT ON saas_events_seen TO {{app}};
-- Upstream MCP connections (NetSuite QuickStart): last check and tools;
-- DELETE when the integration is deleted.
GRANT SELECT, INSERT, UPDATE, DELETE ON mcp_connections TO {{app}};
-- Logical application integrations (provider tenants) and their transports.
GRANT SELECT, INSERT, UPDATE, DELETE ON app_integrations TO {{app}};
GRANT SELECT, INSERT, UPDATE, DELETE ON rest_connections TO {{app}};
